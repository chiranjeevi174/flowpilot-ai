# ==============================================================================
# FlowPilot AI - Production Environment Variables Example
# ==============================================================================
# Copy this file to '.env.prod' in the infrastructure/ directory:
#   cp infrastructure/.env.prod.example infrastructure/.env.prod
#
# Replace all placeholders with strong production values before running:
#   docker compose -f infrastructure/compose.prod.yaml --env-file infrastructure/.env.prod up -d
# ==============================================================================

# Public Host Port & App URL
PORT=80
APP_URL="http://your-domain.com"

# PostgreSQL Credentials (Strong, unique passwords)
POSTGRES_USER="flowpilot_admin"
POSTGRES_PASSWORD="change_this_to_a_strong_random_db_password"
POSTGRES_DB="flowpilot_production"

# Application Security (Minimum 32 cryptographically random characters)
JWT_SECRET_KEY="generate-a-strong-secret-key-with-openssl-rand-hex-32"

# Fernet Encryption Keys for BYOK & OAuth (JSON array of base64 Fernet keys)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEYS=["primary_fernet_key_base64_32bytes="]
INTEGRATION_ENCRYPTION_KEYS=["primary_fernet_key_base64_32bytes="]

# CORS Allowed Origins (Explicit production domains only; NO WILDCARDS)
CORS_ORIGINS=["http://your-domain.com","https://your-domain.com"]

# Optional Deployment-owned OAuth Providers (Google & Slack)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/v1/integrations/google/callback"

SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
SLACK_REDIRECT_URI="https://your-domain.com/api/v1/integrations/slack/callback"
