# ==============================================================================
# FlowPilot AI - Infrastructure Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' in the infrastructure directory or project root:
#   cp infrastructure/.env.example infrastructure/.env
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=flowpilot_dev_password
POSTGRES_DB=flowpilot
POSTGRES_PORT=5433

# Redis Configuration
REDIS_PORT=6379

# Encryption Configuration
LLM_ENCRYPTION_KEYS=k1V9O2gDqG4g3VzZ6X_K5y5uW1qR9nS8lJ4fA0bC2eY=
INTEGRATION_ENCRYPTION_KEYS=k1V9O2gDqG4g3VzZ6X_K5y5uW1qR9nS8lJ4fA0bC2eY=

# Google OAuth 2.0 Credentials (Deployment Owned)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# Slack OAuth 2.0 Credentials (Deployment Owned)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback
