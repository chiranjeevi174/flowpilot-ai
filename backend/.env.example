# ==============================================================================
# FlowPilot AI Backend - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' in the backend directory for local development:
#   cp .env.example .env
#
# DO NOT store real production secrets or API keys in this example file.
# ==============================================================================

# Application Configuration
APP_NAME="FlowPilot API"
SERVICE_NAME="flowpilot-api"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# API Routing
API_V1_PREFIX="/api/v1"

# CORS Configuration (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL + asyncpg)
# Default port 5433 maps to containerized Postgres (avoids local port 5432 conflicts)
DATABASE_URL="postgresql+asyncpg://flowpilot:flowpilot_dev_password@127.0.0.1:5433/flowpilot"
TEST_DATABASE_URL="postgresql+asyncpg://flowpilot:flowpilot_dev_password@127.0.0.1:5433/flowpilot_test"
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Authentication & JWT Configuration
# In production, set JWT_SECRET_KEY to a cryptographically random string (min 32 chars)
JWT_SECRET_KEY="insecure-development-secret-key-change-in-production-min32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Authentication Cookie Configuration
AUTH_COOKIE_NAME="refresh_token"
# Leave empty in development to automatically use False, True in production
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE="lax"

# ==============================================================================
# Multi-LLM Gateway & BYOK Encryption Configuration
# ==============================================================================
# Comma-separated list or JSON array of 32-byte URL-safe base64-encoded Fernet keys.
# Generate a key using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For key rotation (MultiFernet):
#   Set LLM_ENCRYPTION_KEYS="<new-primary-key>,<old-secondary-key>"
# New credentials will be encrypted using the first key; existing ones can be decrypted by any key.
LLM_ENCRYPTION_KEYS=

# Gateway Configuration
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_FACTOR=1.5

# ==============================================================================
# Redis & Celery Background Execution Configuration
# ==============================================================================
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/1"
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
# ==============================================================================
# External Integrations & OAuth 2.0 Configuration (Phase 6)
# ==============================================================================
# Fernet keys for encrypting OAuth tokens at rest (defaults to LLM_ENCRYPTION_KEYS if empty)
INTEGRATION_ENCRYPTION_KEYS=

# Google OAuth 2.0 Credentials (Deployment-owned)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google/callback"

# Slack OAuth 2.0 Credentials (Deployment-owned)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI="http://localhost:8000/api/v1/integrations/slack/callback"

# WhatsApp Business Platform (Cloud API) Configuration
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION="v21.0"

OAUTH_STATE_EXPIRE_SECONDS=600

